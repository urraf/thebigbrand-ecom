# ── Local development (never commit real secrets) ──
DATABASE_URL="postgresql://tbb:tbb_dev_pw@127.0.0.1:5440/tbb?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3200"
ROOT_DOMAIN="localhost:3200"          # seller portal is served on seller.<ROOT_DOMAIN>
OTP_DEV_MODE="true"                    # show OTP on screen when no SMS provider is configured
SEED_ADMIN_EMAIL="admin@thebigbrands.co.in"
SEED_ADMIN_PASSWORD="Admin@12345"
# Razorpay (leave empty to use the built-in TEST gateway)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# SMS OTP provider (MSG91) — optional
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
# File storage: "local" (public/uploads) or "blob" (Vercel Blob, needs BLOB_READ_WRITE_TOKEN)
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""
