// The Big Brands — marketplace platform schema (PostgreSQL, Prisma 7)
// CONVENTIONS
// - All money fields are INTEGER RUPEES (₹) unless the name ends in `Paise` or the field is a Float report value.
//   Convert to paise only at the payment-gateway boundary (Razorpay expects paise).
// - Soft enums are real Postgres enums below. JSON `meta` fields are escape hatches for format-specific extras.
// - Schema is owned by the foundation. Feature agents do not edit this file; they request changes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Users & auth ─────────────────────────────

enum Role {
  CUSTOMER
  SELLER
  STAFF
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String?   @unique
  phone        String?   @unique // 10-digit Indian mobile, no +91
  name         String?
  passwordHash String?
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions       Session[]
  addresses      Address[]
  orders         Order[]
  cart           Cart?
  wishlist       WishlistItem[]
  reviews        Review[]
  seller         Seller?
  advertiser     Advertiser?
  couponClips    CouponClip[]
  couponUses     CouponUse[]
  auditLogs      AuditLog[]
  mediaUploads   Media[]
  searchQueries  SearchQuery[]

  @@index([role])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum OtpPurpose {
  LOGIN
  VERIFY_PHONE
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String
  codeHash   String
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([phone, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // Home / Work
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Brand {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  // wordmark styling (logo rendered as styled text when logoUrl is empty)
  word         String?
  sub          String?
  color        String    @default("#17121f")
  accent       String?
  font         String?   // CSS font-family stack
  fontWeight   Int       @default(700)
  textTransform String   @default("none")
  letterSpacing String   @default("0")
  italic       Boolean   @default(false)
  tagline      String?
  description  String?
  logoUrl      String?
  bannerUrl    String?
  isOwn        Boolean   @default(false) // The Big Brands' own label (TBB Originals)
  featured     Boolean   @default(false)
  storeActive  Boolean   @default(false) // paid brand store (ad slot B1)
  storeActiveUntil DateTime?
  followers    Int       @default(0)
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  products     Product[]
  coupons      Coupon[]
  campaigns    AdCampaign[]
  advertisers  Advertiser[]
  sponsoredConcerns Concern[]
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  short     String?
  description String?
  imageUrl  String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  products  Product[]
}

model Concern {
  id             String  @id @default(cuid())
  slug           String  @unique
  name           String
  emoji          String?
  description    String?
  sponsorBrandId String? // default "presented by" sponsor (ad slot H4); an H4 campaign with targetKey=slug overrides
  sponsorBrand   Brand?  @relation(fields: [sponsorBrandId], references: [id])
  sortOrder      Int     @default(0)
}

enum ProductStatus {
  DRAFT
  PENDING   // submitted by a seller, awaiting admin approval
  ACTIVE
  REJECTED
  ARCHIVED
}

model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  brandId         String
  brand           Brand         @relation(fields: [brandId], references: [id])
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id])
  sellerId        String?       // null = sold by The Big Brands Retail
  seller          Seller?       @relation(fields: [sellerId], references: [id])
  sku             String?       @unique
  size            String?       // "340 ml"
  mrp             Int
  price           Int
  stock           Int           @default(0)
  status          ProductStatus @default(DRAFT)
  rejectionReason String?
  description     String?
  howToUse        String?
  ingredients     String?
  bullets         String[]      @default([])
  concerns        String[]      @default([]) // Concern slugs
  tags            String[]      @default([]) // search keywords
  badge           String?       // "Bestseller", "Derm pick"
  // packshot fallback (SVG art) when there is no photo
  shape           String?       // bottle | tube | dropper | jar | pump | stick
  colorPrimary    String?
  colorSecondary  String?
  rating          Float         @default(0)
  reviewCount     Int           @default(0)
  soldCount       Int           @default(0) // drives "X bought in past month"
  isFeatured      Boolean       @default(false)
  isOwnLabel      Boolean       @default(false) // TBB Originals full-size product
  meta            Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images          ProductImage[]
  reviews         Review[]
  cartItems       CartItem[]
  wishlistedBy    WishlistItem[]
  orderItems      OrderItem[]
  giftItem        GiftItem?

  @@index([brandId])
  @@index([categoryId])
  @@index([sellerId])
  @@index([status])
}

model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  alt         String?
  width       Int?
  height      Int?
  sortOrder   Int     @default(0)
  source      String? // e.g. "Open Beauty Facts", "seller upload"
  sourceUrl   String?
  license     String? // e.g. "CC BY-SA 3.0"
  attribution String?

  @@index([productId])
}

model Review {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName String
  city       String?
  rating     Int
  title      String?
  body       String
  verified   Boolean  @default(false)
  helpful    Int      @default(0)
  isPublished Boolean @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
}

// ───────────────────────────── Free gifts (client's key mechanic) ─────────────────────────────

model GiftItem {
  id        String   @id @default(cuid())
  productId String   @unique // the full-size TBB Original this mini comes from
  product   Product  @relation(fields: [productId], references: [id])
  miniName  String   // "Vitamin C Glow Face Wash"
  miniSize  String   // "30 ml mini"
  worth     Int      // ₹ value shown as "worth ₹149"
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  orderGifts OrderGift[]
}

model GiftTier {
  id        String  @id @default(cuid())
  minAmount Int     // cart subtotal threshold in ₹ (0 = every order)
  giftCount Int
  isActive  Boolean @default(true)
}

// ───────────────────────────── Cart & wishlist ─────────────────────────────

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?    @unique // cookie for guest carts
  couponCode String?
  giftIds    String[]   @default([]) // GiftItem ids chosen at checkout
  updatedAt  DateTime   @updatedAt
  createdAt  DateTime   @default(now())

  items      CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Int
  savedForLater Boolean @default(false)
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

// ───────────────────────────── Orders & payments ─────────────────────────────

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

enum OrderItemStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  RAZORPAY // UPI / cards / netbanking / wallets via Razorpay Checkout
  COD
  TEST     // local/demo gateway when Razorpay keys are not configured
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_PENDING
}

model Order {
  id            String        @id @default(cuid())
  number        String        @unique // TBB2611240001
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  mrpTotal      Int
  subtotal      Int           // Σ price × qty
  discount      Int           @default(0) // coupon discount
  shippingFee   Int           @default(0)
  codFee        Int           @default(0)
  total         Int
  couponCode    String?
  // shipping address snapshot
  shipName      String
  shipPhone     String
  shipLine1     String
  shipLine2     String?
  shipLandmark  String?
  shipCity      String
  shipState     String
  shipPincode   String
  notes         String?
  placedAt      DateTime?
  deliveredAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         OrderItem[]
  gifts         OrderGift[]
  payments      Payment[]
  events        OrderEvent[]
  couponUses    CouponUse[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id             String          @id @default(cuid())
  orderId        String
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  sellerId       String?
  seller         Seller?         @relation(fields: [sellerId], references: [id])
  // snapshot
  name           String
  brandName      String
  size           String?
  imageUrl       String?
  mrp            Int
  price          Int
  qty            Int
  lineTotal      Int
  status         OrderItemStatus @default(PLACED)
  courier        String?
  trackingNumber String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  // marketplace economics (for seller items)
  commissionPct  Float           @default(0)
  commissionAmt  Int             @default(0)
  sellerEarning  Int             @default(0)

  ledgerEntries  SellerLedgerEntry[]

  @@index([orderId])
  @@index([sellerId])
}

model OrderGift {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  giftItemId String
  giftItem   GiftItem @relation(fields: [giftItemId], references: [id])
  name       String
  miniSize   String
  worth      Int
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actor     String?     // "system" | "customer" | "admin:<id>" | "seller:<id>"
  createdAt DateTime    @default(now())

  @@index([orderId])
}

enum PaymentProvider {
  RAZORPAY
  TEST
  COD
  MANUAL
}

enum PaymentPurpose {
  ORDER
  AD_CAMPAIGN
}

model Payment {
  id                String          @id @default(cuid())
  purpose           PaymentPurpose  @default(ORDER)
  orderId           String?
  order             Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  campaignId        String?
  campaign          AdCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  providerOrderId   String?         @unique
  providerPaymentId String?
  signature         String?
  amount            Int             // ₹
  currency          String          @default("INR")
  status            PaymentStatus   @default(PENDING)
  raw               Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([orderId])
  @@index([campaignId])
}

// ───────────────────────────── Coupons ─────────────────────────────

enum DiscountType {
  PERCENT
  FLAT
  BOGO
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  title        String       // "₹50 off"
  description  String?      // "on ₹299+"
  type         DiscountType
  value        Int          // percent (1–100) or ₹
  minOrder     Int          @default(0)
  maxDiscount  Int?
  brandId      String?      // brand-scoped coupon (applies to that brand's items only)
  brand        Brand?       @relation(fields: [brandId], references: [id])
  startsAt     DateTime?
  endsAt       DateTime?
  usageLimit   Int?
  perUserLimit Int          @default(1)
  usedCount    Int          @default(0)
  isActive     Boolean      @default(true)
  isSponsored  Boolean      @default(false) // shown on the brand coupon wall (ad slot H9, billed per clip)
  clipCount    Int          @default(0)
  createdAt    DateTime     @default(now())

  clips        CouponClip[]
  uses         CouponUse[]
}

model CouponClip {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, couponId])
}

model CouponUse {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discount  Int
  createdAt DateTime @default(now())

  @@index([couponId, userId])
}

// ───────────────────────────── Sellers (marketplace vendors) ─────────────────────────────

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model Seller {
  id                String       @id @default(cuid())
  userId            String       @unique
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String       @unique // store handle (also usable as subdomain)
  businessName      String       // legal name
  displayName       String       // shown to shoppers
  contactName       String
  email             String
  phone             String
  gstin             String?
  pan               String?
  addressLine       String?
  city              String?
  state             String?
  pincode           String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  upiId             String?
  categories        String[]     @default([]) // category slugs they sell in
  brandsAuthorised  String[]     @default([]) // brand names they are authorised to sell
  description       String?
  logoUrl           String?
  status            SellerStatus @default(PENDING)
  rejectionReason   String?
  commissionPct     Float        @default(12)
  approvedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  products          Product[]
  orderItems        OrderItem[]
  ledger            SellerLedgerEntry[]
  payouts           Payout[]

  @@index([status])
}

enum LedgerType {
  SALE_CREDIT       // item delivered: + item total
  COMMISSION_DEBIT  // − platform commission
  REFUND_DEBIT      // − on return/refund
  PAYOUT            // − money sent to seller
  AD_SPEND          // − sponsored-product ad spend
  ADJUSTMENT        // ± manual
}

model SellerLedgerEntry {
  id          String     @id @default(cuid())
  sellerId    String
  seller      Seller     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type        LedgerType
  amount      Int        // signed ₹ (+ credit to seller, − debit)
  orderItemId String?
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  payoutId    String?
  payout      Payout?    @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  note        String?
  createdAt   DateTime   @default(now())

  @@index([sellerId, createdAt])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id          String       @id @default(cuid())
  sellerId    String
  seller      Seller       @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount      Int
  status      PayoutStatus @default(PENDING)
  reference   String?      // bank UTR
  periodStart DateTime?
  periodEnd   DateTime?
  note        String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())

  entries     SellerLedgerEntry[]

  @@index([sellerId])
}

// ───────────────────────────── Advertising ─────────────────────────────

enum PricingModel {
  DAY
  WEEK
  MONTH
  CPM
  CPC
  CLIP
  BOX
}

model AdSlot {
  id               String       @id @default(cuid())
  code             String       @unique // H1, H2 … S1 … P1 … C1 … B1 … X1
  page             String       // home | search | product | cart | success | brand | offline
  name             String
  format           String
  size             String
  pricingModel     PricingModel
  rate             Float        // ₹ per unit of pricingModel (CLIP can be 1.5)
  positions        Int          @default(1) // concurrent creatives shown
  potentialMonthly Int          @default(0) // ₹ at full occupancy (for the rate card / inspector)
  description      String?
  isActive         Boolean      @default(true) // admin can pause a whole slot
  bookable         Boolean      @default(false) // offered on self-serve booking
  sortOrder        Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  campaigns        AdCampaign[]
}

model Advertiser {
  id          String       @id @default(cuid())
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  companyName String
  contactName String
  email       String
  phone       String?
  gstin       String?
  brandId     String?
  brand       Brand?       @relation(fields: [brandId], references: [id])
  createdAt   DateTime     @default(now())

  campaigns   AdCampaign[]
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW   // submitted (self-serve or seller); admin must approve
  APPROVED         // approved; serves while startsAt ≤ now ≤ endsAt and budget remains
  PAUSED
  REJECTED
  ENDED
}

enum AdPaymentStatus {
  UNPAID
  PAID
  INVOICED
  WAIVED
}

model AdCampaign {
  id              String          @id @default(cuid())
  code            String          @unique // CMP-1042
  name            String
  slotId          String
  slot            AdSlot          @relation(fields: [slotId], references: [id])
  advertiserId    String?
  advertiser      Advertiser?     @relation(fields: [advertiserId], references: [id], onDelete: SetNull)
  brandId         String?
  brand           Brand?          @relation(fields: [brandId], references: [id])
  sellerId        String?         // seller-booked sponsored products
  isHouse         Boolean         @default(false) // The Big Brands' own promo (labelled "The Big Brands", not "Ad")
  status          CampaignStatus  @default(DRAFT)
  priority        Int             @default(0) // higher serves first
  weight          Int             @default(1)
  // creative
  kicker          String?
  headline        String
  subline         String?
  ctaLabel        String?
  linkUrl         String?
  imageUrl        String?         // lifestyle / banner image
  mobileImageUrl  String?
  videoUrl        String?
  theme           Json?           // { bg, fg, accent }
  layout          String?
  productIds      String[]        @default([])
  targetKey       String?         // H4 concern slug · S3 product id · B1 brand slug
  keywords        String[]        @default([]) // S1/S2 search targeting
  meta            Json?           // format extras: reel creator/handle/views, dealPrice, colors…
  // schedule & billing
  startsAt        DateTime
  endsAt          DateTime
  pricingModel    PricingModel
  rate            Float
  budget          Int             @default(0) // ₹ cap (0 = no cap; flat-priced slots use rate × duration)
  spent           Float           @default(0) // cached Σ AdStatDaily.spend
  impressions     Int             @default(0) // cached totals
  clicks          Int             @default(0)
  paymentStatus   AdPaymentStatus @default(UNPAID)
  rejectionReason String?
  createdById     String?
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  stats           AdStatDaily[]
  payments        Payment[]

  @@index([slotId, status])
  @@index([startsAt, endsAt])
}

model AdStatDaily {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  date        DateTime   @db.Date
  impressions Int        @default(0)
  clicks      Int        @default(0)
  spend       Float      @default(0) // ₹ billed for the day

  @@unique([campaignId, date])
}

// ───────────────────────────── Platform ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Media {
  id           String   @id @default(cuid())
  url          String
  mime         String?
  size         Int?
  width        Int?
  height       Int?
  alt          String?
  uploadedById String?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // "product.approve", "campaign.approve", "slot.pause"…
  entity    String
  entityId  String?
  data      Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model SearchQuery {
  id        String   @id @default(cuid())
  q         String
  results   Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Messages from the public /contact page (customers, brands, press). Handled in /admin/messages.
model ContactMessage {
  id          String   @id @default(cuid())
  topic       String   // "order" | "return" | "payment" | "product" | "account" | "brand" | "other"
  name        String
  email       String
  phone       String?
  orderNumber String?
  message     String
  status      String   @default("NEW") // NEW | REPLIED | CLOSED
  userId      String?
  ip          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, createdAt])
}
